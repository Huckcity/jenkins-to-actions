{
  "name": "jenkins-to-actions",
  "version": "1.0.0",
  "description": "Jenkinsfile and Jenkins job config to GitHub Actions converter, with a whole-estate audit",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node test/run.js && node --test test/*.test.js",
    "dev": "npx wrangler dev",
    "deploy": "npx wrangler deploy"
  },
  "keywords": [
    "jenkins",
    "github-actions",
    "migration",
    "ci"
  ],
  "author": "Adam Gibbons",
  "license": "MIT",
  "devDependencies": {
    "yaml": "^2.8.1"
  },
  "type": "module",
  "bin": {
    "jenkins-to-actions": "cli/index.js"
  },
  "files": [
    "cli",
    "public/convert.js",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Huckcity/jenkins-to-actions.git"
  },
  "homepage": "https://jenkins-to-actions.adam-p-gibbons.workers.dev",
  "bugs": "https://github.com/Huckcity/jenkins-to-actions/issues",
  "engines": {
    "node": ">=20"
  }
}
