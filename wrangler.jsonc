{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jenkins-to-actions",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page", "run_worker_first": true },
  "routes": [
    { "pattern": "ci2actions.dev", "custom_domain": true },
    { "pattern": "www.ci2actions.dev", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": { "enabled": false }
}
