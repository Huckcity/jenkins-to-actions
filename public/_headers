/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; base-uri 'self'; form-action 'none'
/app.js
  Cache-Control: public, max-age=600
/convert.js
  Cache-Control: public, max-age=600
/converters/*
  Cache-Control: public, max-age=600
/vendor/*
  Cache-Control: public, max-age=86400
/examples/*
  Cache-Control: public, max-age=3600
